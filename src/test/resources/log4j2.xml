<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

  <Properties>
    <Property name="basePath">/Users/spandanakn/eclipse-workspace/OpenCartV121/logs</Property>
  </Properties>
  
  <Appenders>
  
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger(36) - %msg%n"/>
    </Console>
    
 <!-- <RollingFile name="File" fileName="/Users/spandanakn/eclipse-workspace/OpenCartV121/logs/automation.log" 
             filePattern="/Users/spandanakn/eclipse-workspace/OpenCartV121/logs/automation-%d{yyyy-MM-dd}-%i.log"> --> 
             
      <RollingFile name="File" fileName="${basePath}/automation.log" filePattern="${basePath}/automation-%d{yyyy-MM-dd}-%i.log">
      

      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
      <SizeBasedTriggeringPolicy size="1000"/>
    </RollingFile>
    
  </Appenders>
 
  
  <Loggers>
    <Root level="debug">
      <!-- Here you can use multiple log levels All < Trace < Debug < Info < Warn < Error < Fatal < OFF -->
      <!-- <AppenderRef ref="Console"/> -->
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>
  
</Configuration>